{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "RequestHeaderRemove": "Forwarded"
          }
        ]
      },
      "profile": {
        "ClusterId": "profile",
        "Match": {
          "Path": "/api/profile/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "RequestHeaderRemove": "Forwarded"
          }
        ]
      },
      "skills": {
        "ClusterId": "skills",
        "Match": {
          "Path": "/api/skills/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "RequestHeaderRemove": "Forwarded"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "primary": {
            "Address": "http://auth-service:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HttpClient": {
          "MaxConnectionsPerServer": 100
        }
      },
      "profile": {
        "Destinations": {
          "primary": {
            "Address": "http://profile-service:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HttpClient": {
          "MaxConnectionsPerServer": 100
        }
      },
      "skills": {
        "Destinations": {
          "primary": {
            "Address": "http://skill-service:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HttpClient": {
          "MaxConnectionsPerServer": 100
        }
      }
    }
  }
}
